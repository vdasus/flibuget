<UserControl xmlns="https://github.com/avaloniaui"
       xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
   xmlns:vm="clr-namespace:flibuget.ViewModels"
   mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="600"
    x:Class="flibuget.Views.MainView"
           x:DataType="vm:MainViewModel">
    <Design.DataContext>
   <vm:MainViewModel />
 </Design.DataContext>
    
    <UserControl.Styles>
        <!-- Fix TextBox states for better visibility -->
 <!-- BASE STYLE - Ensure text is ALWAYS visible with dark color -->
    <Style Selector="TextBox">
     <Setter Property="Foreground" Value="#212529"/>
 <Setter Property="CaretBrush" Value="#4F8EF7"/>
     <Setter Property="SelectionBrush" Value="#4F8EF7"/>
      <Setter Property="SelectionForegroundBrush" Value="White"/>
 </Style>
     
     <!-- Explicitly set foreground for ALL states -->
     <Style Selector="TextBox:not(:focus)">
     <Setter Property="Foreground" Value="#212529"/>
 </Style>
        
 <Style Selector="TextBox:focus">
    <Setter Property="Foreground" Value="#212529"/>
    </Style>
 
  <Style Selector="TextBox:pointerover">
  <Setter Property="Foreground" Value="#212529"/>
   </Style>
   
<!-- Normal/Unfocused state -->
     <Style Selector="TextBox /template/ Border#PART_BorderElement">
     <Setter Property="Background" Value="White"/>
  <Setter Property="BorderBrush" Value="#CED4DA"/>
      <Setter Property="BorderThickness" Value="1"/>
      </Style>
    
  <!-- Hover state -->
 <Style Selector="TextBox:pointerover /template/ Border#PART_BorderElement">
  <Setter Property="Background" Value="White"/>
  <Setter Property="BorderBrush" Value="#7FA9F3"/>
    <Setter Property="BorderThickness" Value="1"/>
     </Style>
 
    <!-- Focus state -->
  <Style Selector="TextBox:focus /template/ Border#PART_BorderElement">
 <Setter Property="Background" Value="White"/>
 <Setter Property="BorderBrush" Value="#4F8EF7"/>
     <Setter Property="BorderThickness" Value="2"/>
     </Style>
     
  <!-- Disabled state -->
  <Style Selector="TextBox:disabled">
<Setter Property="Foreground" Value="#6C757D"/>
  </Style>
        
     <!-- Watermark/Placeholder text styling -->
    <Style Selector="TextBox /template/ TextBlock#PART_Watermark">
 <Setter Property="Foreground" Value="#6C757D"/>
 <Setter Property="Opacity" Value="0.7"/>
    </Style>
   
  <!-- ReadOnly TextBox styling -->
   <Style Selector="TextBox:readonly /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
     </Style>
        
      <!-- Button styling to fix hover issue -->
      <Style Selector="Button">
        <Setter Property="Background" Value="#4F8EF7"/>
<Setter Property="Foreground" Value="White"/>
  </Style>
   
    <Style Selector="Button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
     <Setter Property="Background" Value="#3A7DE8"/>
     <Setter Property="TextBlock.Foreground" Value="White"/>
     </Style>
    
        <Style Selector="Button:pressed /template/ ContentPresenter#PART_ContentPresenter">
     <Setter Property="Background" Value="#2E6BD6"/>
<Setter Property="TextBlock.Foreground" Value="White"/>
    </Style>
    </UserControl.Styles>
    
    <!-- DockPanel fills entire UserControl -->
    <DockPanel>
        <!-- Main content area with padding -->
  <Border DockPanel.Dock="Top" Padding="20,10" Background="#F5F7FA">
         <!-- Grid with rows that properly distribute space -->
            <Grid RowDefinitions="Auto,Auto,*" MaxWidth="1400" Margin="0,10">
 
          <!-- Header -->
    <TextBlock Grid.Row="0"
     Text="{Binding Greeting}" 
          HorizontalAlignment="Center" 
    FontSize="32" 
             FontWeight="Bold"
     Foreground="#2C3E50"
         Margin="0,10,0,20"/>
         
  <!-- Search Section -->
   <Border Grid.Row="1"
       Background="White" 
      CornerRadius="12" 
          Padding="24"
 BoxShadow="0 2 8 0 #10000000"
              Margin="0,0,0,20">
    <StackPanel Spacing="16">
     <TextBlock Text="Search Audiobook" 
        FontSize="18" 
      FontWeight="SemiBold"
       Foreground="#34495E"/>
     
          <Grid ColumnDefinitions="*,20,*">
     <!-- Author Input -->
    <StackPanel Grid.Column="0">
 <TextBlock Text="Author" 
   FontWeight="Medium"
                Foreground="#7F8C8D"
    Margin="0,0,0,8"/>
 <TextBox Text="{Binding Author}" 
          Watermark="e.g., J.R.R. Tolkien"
          MinHeight="40"
        CornerRadius="6"
         FontSize="15"/>
           </StackPanel>
     
        <!-- Book Input -->
         <StackPanel Grid.Column="2">
      <TextBlock Text="Book Title" 
   FontWeight="Medium"
        Foreground="#7F8C8D"
     Margin="0,0,0,8"/>
<TextBox Text="{Binding Book}" 
       Watermark="e.g., The Hobbit"
   MinHeight="40"
          CornerRadius="6"
           FontSize="15"/>
    </StackPanel>
      </Grid>
 
       <!-- Search Button -->
          <Button HorizontalAlignment="Stretch" 
       MinHeight="48"
           FontSize="16"
          FontWeight="SemiBold"
   CornerRadius="8"
        Background="#4F8EF7" 
         Foreground="White"
Margin="0,8,0,0"
    IsDefault="True"
     Command="{Binding ClickCommand}">
   <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="10">
               <TextBlock Text="&#x1F50D;" FontSize="16" VerticalAlignment="Center"/>
              <TextBlock Text="Search Audiobook" FontSize="16" VerticalAlignment="Center"/>
          </StackPanel>
    </Button>
    </StackPanel>
        </Border>
   
     <!-- Results Section - Takes ALL remaining vertical space -->
 <Border Grid.Row="2"
  Background="White" 
          CornerRadius="12" 
       Padding="24"
        BoxShadow="0 2 8 0 #10000000"
               IsVisible="{Binding Result, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
             <!-- Use DockPanel for better space distribution -->
             <DockPanel>
        <!-- Book Cover on the left -->
        <Border DockPanel.Dock="Left"
        CornerRadius="8"
      ClipToBounds="True"
    Background="#ECF0F1"
    Width="220"
 Height="220"
       Margin="0,0,24,0"
 VerticalAlignment="Top">
              <Panel>
     <Image x:Name="BookCoverImage"
            Source="{Binding CoverImage}" 
       Stretch="UniformToFill"
         RenderOptions.BitmapInterpolationMode="HighQuality"
           IsVisible="{Binding CoverImage, Converter={x:Static ObjectConverters.IsNotNull}}"/>
       <TextBlock Text="&#x1F4DA;"
      FontSize="72"
        HorizontalAlignment="Center"
      VerticalAlignment="Center"
  Foreground="#BDC3C7"
      IsVisible="{Binding CoverImage, Converter={x:Static ObjectConverters.IsNull}}"/>
               </Panel>
            </Border>
       
           <!-- Book Details - Fill remaining horizontal AND vertical space -->
       <Grid RowDefinitions="Auto,*">
   <TextBlock Grid.Row="0"
     Text="Audiobook Details" 
         FontSize="22" 
      FontWeight="SemiBold"
  Foreground="#2C3E50"
      Margin="0,0,0,16"/>
  
      <!-- This Border and its contents will stretch to fill available space -->
     <Border Grid.Row="1"
  Background="#F8F9FA"
      CornerRadius="8"
 Padding="20">
        <!-- TextBox inside ScrollViewer - will grow with window -->
          <ScrollViewer VerticalScrollBarVisibility="Auto"
          HorizontalScrollBarVisibility="Disabled">
    <TextBox Text="{Binding Result}" 
          IsReadOnly="True"
     AcceptsReturn="True"
    TextWrapping="Wrap"
           BorderThickness="0"
       Background="Transparent"
  FontSize="15"
                  LineHeight="24"
    Foreground="#2C3E50"
                 Padding="0"/>
          </ScrollViewer>
               </Border>
           </Grid>
         </DockPanel>
        </Border>
    
    <!-- Empty State - Takes ALL remaining vertical space when visible -->
            <Border Grid.Row="2"
    Background="White" 
        CornerRadius="12" 
           Padding="48"
     BoxShadow="0 2 8 0 #10000000"
    IsVisible="{Binding Result, Converter={x:Static StringConverters.IsNullOrEmpty}}">
       <StackPanel Spacing="16" 
        HorizontalAlignment="Center" 
          VerticalAlignment="Center">
    <TextBlock Text="&#x1F3A7;" 
       FontSize="64"
         HorizontalAlignment="Center"
   Foreground="#BDC3C7"/>
   <TextBlock Text="Search for an audiobook to get started" 
         FontSize="18"
      Foreground="#95A5A6"
      HorizontalAlignment="Center"
  TextAlignment="Center"
        TextWrapping="Wrap"
            MaxWidth="400"/>
           </StackPanel>
                </Border>
       </Grid>
        </Border>
    </DockPanel>
</UserControl>